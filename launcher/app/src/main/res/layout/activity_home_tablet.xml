<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen for tablets: clock and quick chips on top, app grid below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/screen_margin">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextClock
                style="@style/Clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm" />

            <TextClock
                style="@style/DateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_inputs"
                style="@style/Chip"
                android:drawableStart="@drawable/ic_input"
                android:text="@string/inputs"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_network"
                style="@style/Chip"
                android:drawableStart="@drawable/ic_wifi"
                android:text="@string/net_wifi" />

            <TextView
                android:id="@+id/chip_settings"
                style="@style/Chip"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/settings" />
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
