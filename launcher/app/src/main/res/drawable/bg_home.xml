<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black with a soft champagne light from the upper left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/background" />
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.1"
                android:centerY="0.05"
                android:endColor="#0008090B"
                android:centerColor="#2E2A2620"
                android:gradientRadius="110%p"
                android:startColor="#663D3830"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
